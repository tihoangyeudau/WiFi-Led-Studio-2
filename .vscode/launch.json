    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Wls",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/wls/__main__.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "windows": {
                "program": "${workspaceFolder}\\wls\\__main__.py"
            }
        },
        {
            "name": "Python: Wls Verbose Logging",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/wls/__main__.py",
            "args": ["-vv"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "windows": {
                "program": "${workspaceFolder}\\wls\\__main__.py"
            }
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        }

    ]


}